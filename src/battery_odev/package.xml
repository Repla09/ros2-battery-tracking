<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>battery_odev</name>
  <version>0.1.0</version>
  <description>
    Battery tracking for an underwater vehicle: a battery node that publishes the
    battery level and offers a /recharge service, and a monitor node that warns
    when the battery is low.
  </description>
  <maintainer email="218998084+Repla09@users.noreply.github.com">Repla09</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
